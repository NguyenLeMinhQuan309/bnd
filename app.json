{
  "expo": {
    "name": "Bannoidia",
    "slug": "bannoidia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.bannoidia.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bannoidia.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "scheme": "bannoidia",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2981d07-0742-49b6-a8a3-5903c4632030"
      }
    }
  }
}
